rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function staffRole() {
      return userExists() ? get(userDocPath()).data.get('role', '') : '';
    }

    function isProvincialStaffFromUserDoc() {
      return userExists()
        && (
          staffRole().matches('(?i)^\\s*governor\\s*$')
          || staffRole().matches('(?i)^\\s*provincial[_\\s-]?tourism\\s*$')
          || staffRole().matches('(?i)^\\s*tourism[_\\s-]?province\\s*$')
          || isLguOfficeRole(staffRole())
        );
    }

    /// Tourism / governor demo and LGU staff emails (works even before users/{uid} exists).
    /// Trip Planner OPTACA portal. Read-only access to the same provincial
    /// records tourism@gmail.com already uses. Not a write role.
    function isOptacaPortalReader() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.matches('(?i)^optaca@gmail\\.com$');
    }

    function isKnownStaffEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email.matches('(?i)^optaca@gmail\\.com$')
          || request.auth.token.email.matches('(?i)^governor\\.atmos@misocc-demo\\.ph$')
          || request.auth.token.email.matches('(?i)^tourismoffice\\.atmos@misocc-demo\\.ph$')
          || request.auth.token.email.matches('(?i)^provincial\\.tourism@misocc-demo\\.ph$')
          || request.auth.token.email.matches('(?i)^tourism@gmail\\.com$')
          || request.auth.token.email.matches('(?i)^tourism\\.[^@]+@.+$')
          || request.auth.token.email.matches('(?i)^tourismoroquieta@.+$')
          || request.auth.token.email.matches('(?i)^oroquieta\\.tourism@.+$')
          || request.auth.token.email.matches('(?i)^.*\\.tourism@.+$')
          || request.auth.token.email.matches('(?i)^.*(tourism|governor|misocc|atmos).*@.+$')
        );
    }

    function lguMunicipalityId() {
      // Prefer the normalized `municipalityId` field; fall back to the display
      // `municipality` field for accounts created before the field was added
      // (e.g. docs that only have municipality:"oroquieta").
      return userExists()
        ? (get(userDocPath()).data.get('municipalityId', '').size() > 0
            ? get(userDocPath()).data.get('municipalityId', '')
            : get(userDocPath()).data.get('municipality', ''))
        : '';
    }

    function isLguTourismFromUserDoc() {
      return userExists()
        && isLguOfficeRole(staffRole())
        && lguMunicipalityId() != '';
    }

    function isProvincialStaff() {
      return isSignedIn()
        && (isProvincialStaffFromUserDoc() || isKnownStaffEmail());
    }

    function isLguStaff() {
      return isProvincialStaff() || isLguTourismFromUserDoc();
    }

    function lguCatalogName(id) {
      return id == 'oroquieta' ? 'Oroquieta City'
        : id == 'ozamiz' ? 'Ozamis City'
        : id == 'tangub' ? 'Tangub City'
        : id == 'aloran' ? 'Aloran'
        : id == 'baliangao' ? 'Baliangao'
        : id == 'bonifacio' ? 'Bonifacio'
        : id == 'calamba' ? 'Calamba'
        : id == 'clarin' ? 'Clarin'
        : id == 'concepcion' ? 'Concepcion'
        : id == 'dvc' ? 'Don Victoriano Chiongbian'
        : id == 'jimenez' ? 'Jimenez'
        : id == 'lopezjaena' ? 'Lopez Jaena'
        : id == 'panaon' ? 'Panaon'
        : id == 'plaridel' ? 'Plaridel'
        : id == 'sapangdalaga' ? 'Sapang Dalaga'
        : id == 'sinacaban' ? 'Sinacaban'
        : id == 'tudela' ? 'Tudela'
        : '';
    }

    function isLguOfficeRole(role) {
      return role.matches('(?i)^\\s*tourism(_office)?\\s*$')
        || role.matches('(?i)^\\s*lgu(_tourism|_office)?\\s*$')
        || role.matches('(?i)^\\s*lgu\\s*tourism\\s*$')
        || role.matches('(?i)^\\s*tourism\\s*office\\s*$')
        || role.matches('(?i)^\\s*municipal[_\\s-]?tourism\\s*$');
    }

    function holderOwnsLguOffice(uid, municipalityId) {
      let data = get(/databases/$(database)/documents/users/$(uid)).data;
      let stored = data.get('municipalityId', '') == 'ozamis'
        ? 'ozamiz'
        : data.get('municipalityId', '');
      let name = data.get('municipality', '').lower();
      let catalog = lguCatalogName(municipalityId).lower();
      return catalog.size() > 0 && (
        (stored.size() > 0 && stored == municipalityId)
        || (stored.size() == 0 && (
          name == catalog
          || (municipalityId == 'ozamiz' && (
            name == 'ozamiz city' || name == 'ozamis' || name == 'ozamiz'
          ))
          || (municipalityId == 'dvc' && name == 'don victoriano')
        ))
      );
    }

    function touristRegisteredInLguMunicipality() {
      return isLguTourismFromUserDoc()
        && resource.data.get('registrationMunicipalityId', '') == lguMunicipalityId();
    }

    function checkInInLguMunicipality() {
      return isLguTourismFromUserDoc()
        && resource.data.get('municipalityId', '') == lguMunicipalityId();
    }

    function canReadTouristDoc(touristId) {
      return isSignedIn()
        && (
          request.auth.uid == touristId
          || isProvincialStaff()
          || touristRegisteredInLguMunicipality()
        );
    }

    function canReadOwnCheckInRow() {
      return isSignedIn()
        && (
          resource.data.get('user_id', '') == request.auth.uid
          || resource.data.get('userId', '') == request.auth.uid
          || resource.data.get('tourist_id', '') == request.auth.uid
        );
    }

    /// Tourist QR registration / check-in write (mobile scanner).
    function isQrCheckInOwner() {
      return isSignedIn()
        && (
          request.resource.data.get('tourist_id', '') == request.auth.uid
          || request.resource.data.get('userId', '') == request.auth.uid
          || request.resource.data.get('user_id', '') == request.auth.uid
        );
    }

    function isCheckInOwner() {
      return isSignedIn()
        && request.resource.data.get('user_id', '') == request.auth.uid;
    }

    match /tourists/{touristId} {
      // Signed-in read: LGU dashboards list/filter tourists; tourists read own profile.
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && (request.auth.uid == touristId || isLguStaff());
      // Governor / tourism may remove tourist profiles from dashboards.
      allow delete: if isLguStaff();
    }

    /// Analytics only. Tour content is tourist_spots.vr_link (LGU-only via tourist_spots rules).
    /// Signed-in may sync/increment views; OPTACA cannot change tour URLs through this collection.
    match /vr_tours/{vrTourId} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if isLguTourismFromUserDoc();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
                  && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn()
                     && resource.data.user_id == request.auth.uid;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      // LGU owns municipal announcements; OPTACA / provincial may manage
      // province-wide posts from the portal Events & Announcements tab.
      allow create, update, delete: if isLguTourismFromUserDoc()
        || provincialMayManageSpot();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (request.auth.uid == userId
            || (isLguStaff()
                && request.resource.data.get('role', 'tourist') == 'tourist'));
      allow update: if isSignedIn()
        && (request.auth.uid == userId || isLguStaff());
      // Staff may delete tourist role docs (never used for self-service Auth delete).
      allow delete: if isLguStaff()
        && (
          !('role' in resource.data)
          || resource.data.role == 'tourist'
          || resource.data.role == 'Tourist'
        );

      match /faq_chats/{messageId} {
        allow read, create, update, delete: if isSignedIn()
                                              && request.auth.uid == userId;
      }
    }

    match /tourist_activity/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isLguStaff();
    }

    match /email_otps/{otpUid} {
      allow read, create, update, delete: if isSignedIn()
                                          && request.auth.uid == otpUid;
      allow delete: if isLguStaff();
    }

    match /check_ins/{docId} {
      allow get: if isLguStaff() || isOptacaPortalReader() || canReadOwnCheckInRow();
      allow list: if isLguStaff() || isOptacaPortalReader() || canReadOwnCheckInRow() || checkInInLguMunicipality();
      allow create, update: if isSignedIn();
      allow delete: if isLguStaff();
    }

    /// "Laag with Friends": a group check-in must come from the group's leader
    /// while the group is unexpired, and list only real group members.
    function isValidGroupCheckIn() {
      let data = request.resource.data;
      return !('groupId' in data)
        || (
          exists(/databases/$(database)/documents/tourist_groups/$(data.groupId))
          && get(/databases/$(database)/documents/tourist_groups/$(data.groupId)).data.leaderUid == request.auth.uid
          && get(/databases/$(database)/documents/tourist_groups/$(data.groupId)).data.expiresAt > request.time
          && get(/databases/$(database)/documents/tourist_groups/$(data.groupId)).data.memberUids
               .hasAll(data.get('groupMemberUids', []))
        );
    }

    function isLaagMemberCheckIn() {
      let data = request.resource.data;
      let group = get(/databases/$(database)/documents/tourist_groups/$(data.groupId)).data;
      let member = group.members[data.userId];
      return data.get('source', '') == 'laag_group'
        && data.groupId is string
        && data.partySize == 1
        && data.visitorCount == 1
        && !data.keys().hasAny(['groupMembers'])
        && data.userId is string
        && data.tourist_id == data.userId
        && data.user_id == data.userId
        && exists(/databases/$(database)/documents/tourist_groups/$(data.groupId))
        && group.leaderUid == request.auth.uid
        && group.status == 'active'
        && group.expiresAt > request.time
        && group.memberUids.hasAny([data.userId])
        && (
          !('status' in member)
          || member.status == 'accepted'
        );
    }

    match /tourist_groups/{groupId} {
      allow get: if isSignedIn();
      // Join-by-code lookup only (small result sets).
      allow list: if isSignedIn() && request.query.limit <= 5;
      allow create: if isSignedIn()
        && request.resource.data.leaderUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.status == 'active'
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.size() == 6
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(13, 'h');
      // Leader manages the group; cannot hand off, extend, or change the code.
      allow update: if isSignedIn()
        && resource.data.leaderUid == request.auth.uid
        && request.resource.data.leaderUid == resource.data.leaderUid
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.memberUids.hasAll([request.auth.uid])
        && request.resource.data.memberUids.size() <= 30;
      // Other tourists may only add or remove themselves.
      allow update: if isSignedIn()
        && resource.data.leaderUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'members', 'pendingInviteUids', 'pendingInvites'])
        && request.resource.data.memberUids.toSet()
             .difference(resource.data.memberUids.toSet())
             .union(resource.data.memberUids.toSet()
               .difference(request.resource.data.memberUids.toSet()))
             .hasOnly([request.auth.uid])
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('pendingInvites', {}).diff(resource.data.get('pendingInvites', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('pendingInviteUids', []).toSet()
             .difference(resource.data.get('pendingInviteUids', []).toSet())
             .union(resource.data.get('pendingInviteUids', []).toSet()
               .difference(request.resource.data.get('pendingInviteUids', []).toSet()))
             .hasOnly([request.auth.uid])
        && (
          !request.resource.data.memberUids.hasAll([request.auth.uid])
          || (
            resource.data.status == 'active'
            && resource.data.expiresAt > request.time
            && request.resource.data.memberUids.size() <= 30
          )
        );
      allow delete: if isSignedIn() && resource.data.leaderUid == request.auth.uid;
    }

    match /qr_checkins/{docId} {
      // Signed-in read: LGU dashboards + tourists viewing own history (client filters by municipality).
      allow get, list: if isSignedIn();
      allow create: if (isQrCheckInOwner() && isValidGroupCheckIn())
                    || isLaagMemberCheckIn()
                    || isLguStaff();
      allow update: if isSignedIn()
                    && (resource.data.get('tourist_id', '') == request.auth.uid
                        || isLguStaff());
      allow delete: if isLguStaff();
    }

    match /checkins/{docId} {
      allow get: if isLguStaff() || isOptacaPortalReader() || canReadOwnCheckInRow();
      allow list: if isLguStaff() || isOptacaPortalReader() || canReadOwnCheckInRow() || checkInInLguMunicipality();
      allow create: if isCheckInOwner() || isLguStaff();
      allow update: if false;
      allow delete: if isLguStaff();
    }

    /// Landing page total only. No names, emails, or other tourist fields.
    match /public_stats/landing {
      allow read: if true;
      allow write: if false;
    }

    /// Destinations: LGU manages own municipality; OPTACA / provincial may
    /// manage the province-wide catalog (portal Tourist Spots tab).
    function spotMunicipalityId(data) {
      let mid = data.get('municipalityId', '');
      return mid == 'ozamis' ? 'ozamiz' : mid;
    }

    function spotMunicipalityName(data) {
      return data.get('municipality', '').lower();
    }

    function lguOwnsSpotData(data) {
      let mid = lguMunicipalityId() == 'ozamis' ? 'ozamiz' : lguMunicipalityId();
      let catalog = lguCatalogName(mid).lower();
      let dataMid = spotMunicipalityId(data);
      let name = spotMunicipalityName(data);
      return isLguTourismFromUserDoc()
        && mid != ''
        && (
          (dataMid != '' && dataMid == mid)
          || (dataMid == '' && catalog.size() > 0 && (
            name == catalog
            || (mid == 'ozamiz' && (
              name == 'ozamiz city' || name == 'ozamis city' || name == 'ozamis' || name == 'ozamiz'
            ))
            || (mid == 'dvc' && (
              name == 'don victoriano' || name == 'don victoriano chiongbian'
            ))
          ))
        );
    }

    function provincialMayManageSpot() {
      return isProvincialStaff() || isOptacaPortalReader();
    }

    match /tourist_spots/{spotId} {
      allow read: if true;
      allow create: if lguOwnsSpotData(request.resource.data)
        || provincialMayManageSpot();
      allow update: if (lguOwnsSpotData(resource.data)
          && lguOwnsSpotData(request.resource.data))
        || provincialMayManageSpot();
      allow delete: if lguOwnsSpotData(resource.data)
        || provincialMayManageSpot();
    }

    /// Province / LGU catalog of municipalities (public read for dropdowns).
    match /municipalities/{muniId} {
      allow read: if true;
      allow create, update, delete: if provincialMayManageSpot();
    }

    /// OPTACA / provincial admin login rows (Trip Planner portal bootstrap).
    match /admin_accounts/{accountId} {
      allow get: if isSignedIn() && (
        isLguStaff()
        || isOptacaPortalReader()
        || !exists(/databases/$(database)/documents/admin_accounts/$(accountId))
        || resource.data.get('emailLower', '') == request.auth.token.email.lower()
        || resource.data.get('firebaseUid', '') == request.auth.uid
      );
      allow list: if isLguStaff() || isOptacaPortalReader();
      allow create, delete: if isProvincialStaff() || isOptacaPortalReader();
      allow update: if isProvincialStaff()
        || isOptacaPortalReader()
        || (
          isSignedIn()
          && request.auth.token.email != null
          && resource.data.get('emailLower', '') == request.auth.token.email.lower()
          && request.resource.data.get('emailLower', '') == request.auth.token.email.lower()
          && request.resource.data.get('firebaseUid', '') == request.auth.uid
        );
    }

    /// Provincial Tourism Office campaigns (province-wide promotions).
    match /provincial_campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isProvincialStaff();
    }

    /// LGU → OPTACA (Provincial Tourism) formal report packages.
    match /lgu_report_submissions/{submissionId} {
      allow read: if isLguStaff() || isOptacaPortalReader();
      allow create: if isLguStaff()
        && request.resource.data.keys().hasAll([
          'municipalityId',
          'reportType',
          'status',
          'periodStart',
          'periodEnd',
          'submittedByUid',
          'submittedAt',
        ])
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow update: if isProvincialStaff()
        || (
          isLguStaff()
          && resource.data.submittedByUid == request.auth.uid
          && request.resource.data.status == 'withdrawn'
        );
      allow delete: if isProvincialStaff();
    }

    match /spot_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() >= 10;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid)
                    || isLguStaff();
    }

    match /tourist_qr_codes/{touristId} {
      allow read: if isSignedIn() && request.auth.uid == touristId;
      allow create, update: if isSignedIn() && request.auth.uid == touristId;
      allow delete: if (isSignedIn() && request.auth.uid == touristId)
                    || isLguStaff();
    }

    match /tourist_qr_codes/{touristId}/history/{historyId} {
      allow read: if isSignedIn() && request.auth.uid == touristId;
      allow create: if isSignedIn() && request.auth.uid == touristId;
      allow update: if false;
      allow delete: if (isSignedIn() && request.auth.uid == touristId)
                    || isLguStaff();
    }

    /// Unique usernames for tourism establishment accounts.
    /// Public get allows pre-signup availability checks; writes require auth.
    match /usernames/{usernameId} {
      allow get: if true;
      allow list: if isSignedIn() || isLguStaff();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid)
                    || isLguStaff();
    }

    /// Tourism establishments (hotels, resorts, restaurants, attractions, …).
    /// Registry reads are open so OPTACA/LGU/AE dashboards work even when the
    /// web Auth token is slow to attach; writes stay owner/staff gated.
    match /accommodation_establishments/{estId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && (
                      request.resource.data.get('ownerUid', '') == request.auth.uid
                      || request.resource.data.get('authUid', '') == request.auth.uid
                      || estId == request.auth.uid
                      || isLguStaff()
                    );
      allow update: if isSignedIn()
                    && (
                      resource.data.get('ownerUid', '') == request.auth.uid
                      || resource.data.get('authUid', '') == request.auth.uid
                      || estId == request.auth.uid
                      || isLguStaff()
                    );
      allow delete: if isLguStaff();
    }

    /// Hotel DOT register (DAE-1B): `ae_monthly_reports/{aeId}_{yyyy}_{mm}` + `rows`.
    /// The hotel (aeId == auth uid) owns its months; LGU reads its municipality,
    /// OPTACA / Governor read province-wide. Staff may write demo-seeded data only.
    function ownsAeReport(reportId) {
      return isSignedIn()
        && reportId.matches('^' + request.auth.uid + '_[0-9]{4}_[0-9]{2}$');
    }

    function registerInLguMunicipality(data) {
      return isLguTourismFromUserDoc()
        && data.get('municipalityId', '') == lguMunicipalityId();
    }

    match /ae_monthly_reports/{reportId} {
      // get: path-based ownership so a hotel can read a month that does not
      // exist yet (resource == null) before creating it.
      allow get: if ownsAeReport(reportId)
        || isProvincialStaff()
        || isOptacaPortalReader()
        || (resource != null && registerInLguMunicipality(resource.data));
      allow list: if isSignedIn()
        && (
          resource.data.get('aeId', '') == request.auth.uid
          || isProvincialStaff()
          || isOptacaPortalReader()
          || registerInLguMunicipality(resource.data)
        );
      allow create: if (ownsAeReport(reportId)
          && request.resource.data.get('aeId', '') == request.auth.uid)
        || (isLguStaff() && request.resource.data.get('seed', '') == 'demo');
      allow update: if (ownsAeReport(reportId)
          && request.resource.data.get('aeId', '') == request.auth.uid)
        || (isLguStaff()
          && (resource.data.get('seed', '') == 'demo'
            || request.resource.data.get('seed', '') == 'demo'));
      allow delete: if ownsAeReport(reportId) || isLguStaff();

      match /rows/{rowId} {
        allow read: if ownsAeReport(reportId) || isLguStaff() || isOptacaPortalReader();
        allow create, update: if ownsAeReport(reportId)
          || (isLguStaff() && request.resource.data.get('seed', '') == 'demo');
        allow delete: if ownsAeReport(reportId) || isLguStaff();
      }
    }

    /// Venue MICE log (CUS MICE): `mice_monthly_reports/{aeId}_{yyyy}_{mm}` + `events`.
    /// Same ownership / visibility model as the DAE-1B register above.
    match /mice_monthly_reports/{reportId} {
      allow get: if ownsAeReport(reportId)
        || isProvincialStaff()
        || isOptacaPortalReader()
        || (resource != null && registerInLguMunicipality(resource.data));
      allow list: if isSignedIn()
        && (
          resource.data.get('aeId', '') == request.auth.uid
          || isProvincialStaff()
          || isOptacaPortalReader()
          || registerInLguMunicipality(resource.data)
        );
      allow create: if (ownsAeReport(reportId)
          && request.resource.data.get('aeId', '') == request.auth.uid)
        || (isLguStaff() && request.resource.data.get('seed', '') == 'demo');
      allow update: if (ownsAeReport(reportId)
          && request.resource.data.get('aeId', '') == request.auth.uid)
        || (isLguStaff()
          && (resource.data.get('seed', '') == 'demo'
            || request.resource.data.get('seed', '') == 'demo'));
      allow delete: if ownsAeReport(reportId) || isLguStaff();

      match /events/{eventId} {
        allow read: if ownsAeReport(reportId) || isLguStaff() || isOptacaPortalReader();
        allow create, update: if ownsAeReport(reportId)
          || (isLguStaff() && request.resource.data.get('seed', '') == 'demo');
        allow delete: if ownsAeReport(reportId) || isLguStaff();
      }
    }

    /// Venue's custom MICE event types (suggestion list).
    match /mice_venue_settings/{aeId} {
      allow read: if isSignedIn() && (request.auth.uid == aeId || isLguStaff() || isOptacaPortalReader());
      allow write: if isSignedIn() && request.auth.uid == aeId;
    }

    /// Sign-offs (name + position + fresh signature) on every major save.
    /// Append-only evidence: nobody can edit or delete a record.
    match /signoffs/{signOffId} {
      allow read: if isSignedIn()
        && (
          resource.data.get('ownerId', '') == request.auth.uid
          || isProvincialStaff()
          || registerInLguMunicipality(resource.data)
        );
      allow create: if isSignedIn()
        && request.resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('accountUid', '') == request.auth.uid
        && request.resource.data.get('signerName', '') is string
        && request.resource.data.signerName.size() >= 2
        && request.resource.data.signerName.size() <= 80
        && request.resource.data.get('signerPosition', '') is string
        && request.resource.data.signerPosition.size() >= 2
        && request.resource.data.signerPosition.size() <= 80
        && request.resource.data.get('signaturePng', null) is bytes
        && request.resource.data.signaturePng.size() <= 400000
        && request.resource.data.get('createdAt', null) == request.time
        && (!(request.resource.data.get('subjectType', '') in ['ae_register', 'mice_register'])
          || ownsAeReport(request.resource.data.get('subjectId', '')));
      allow update, delete: if false;
    }

    /// Remembered signers (name + position) per establishment / owner.
    match /signoff_signers/{ownerId}/people/{personId} {
      allow read, write: if isSignedIn() && request.auth.uid == ownerId;
    }

    /// Retired establishment QR stay flow + stay reviews: staff purge only.
    match /establishment_stay_requests/{stayId} {
      allow read, delete: if isLguStaff();
    }

    match /establishment_stay_reviews/{reviewId} {
      allow read, delete: if isLguStaff();
    }

    /// Which municipality already has an LGU tourism office.
    /// Signup reads this while logged out. User profiles are not modified.
    match /lgu_offices/{municipalityId} {
      allow read: if true;
      allow create: if isSignedIn()
        && lguCatalogName(municipalityId).size() > 0
        && request.resource.data.keys().hasOnly([
          'municipalityId', 'municipality', 'holderUid'
        ])
        && request.resource.data.municipalityId == municipalityId
        && request.resource.data.municipality == lguCatalogName(municipalityId)
        && request.resource.data.holderUid is string
        && request.resource.data.holderUid.size() > 0
        && (
          request.resource.data.holderUid == request.auth.uid
          || isProvincialStaff()
        )
        && exists(/databases/$(database)/documents/users/$(request.resource.data.holderUid))
        && isLguOfficeRole(
          get(/databases/$(database)/documents/users/$(request.resource.data.holderUid)).data.get('role', '')
        )
        && holderOwnsLguOffice(
          request.resource.data.holderUid,
          municipalityId
        );
      allow update, delete: if false;
    }

    /// Trip Planner featured catalog (OPTACA portal + LGU / provincial staff).
    match /featured_spots/{docId} {
      allow read: if true;
      allow write: if isLguStaff() || provincialMayManageSpot();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isLguStaff() || provincialMayManageSpot();
    }

    match /transportation_fees/{docId} {
      allow read: if true;
      allow write: if isLguStaff();
    }

    match /hub_spot_transport_fees/{docId} {
      allow read: if true;
      allow write: if isLguStaff();
    }

    match /municipal_road_distances/{docId} {
      allow read: if true;
      allow write: if isLguStaff();
    }

    /// Map & Routes bus terminals and stops. Public read; staff edit.
    match /bus_locations/{docId} {
      allow read: if true;
      allow write: if isLguStaff();
    }

    /// Custom tourist-spot categories created from Add QR Code.
    match /spot_categories/{categoryId} {
      allow read: if true;
      allow create: if isLguStaff()
        && request.resource.data.keys().hasAll(['name', 'nameKey', 'createdByUid'])
        && request.resource.data.name is string
        && request.resource.data.nameKey is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.name.lower() != 'all'
        && request.resource.data.nameKey == categoryId
        && request.resource.data.nameKey.matches('^[a-z0-9_]+$')
        && request.resource.data.nameKey.size() >= 2
        && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Tourists: own plans only. OPTACA / provincial staff: province-wide
    // read for Trip Planner Analytics (no public list).
    match /tourist_trip/{tripId} {
      allow read: if isSignedIn()
        && (
          resource.data.touristId == request.auth.uid
          || isProvincialStaff()
          || isOptacaPortalReader()
        );
      allow create: if isSignedIn()
        && request.resource.data.touristId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.touristId == request.auth.uid;
    }

    match /spot_ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
