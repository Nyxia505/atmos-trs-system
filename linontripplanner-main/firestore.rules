rules_version = '2';
// Deploy: firebase deploy --only firestore:rules --project atmos-trs-system
//
// SHARED PROJECT: the Tourism trip planner and the ATMOS TRS dashboards both
// use atmos-trs-system. Firestore has ONE ruleset per project, so this file
// must contain the rules for BOTH apps. Deploy the same file from either repo.
//
// Roles
//   Tourism app : admin / governor (isAdmin), municipal_manager (isMunicipalManager),
//                 tourist. Staff = isStaff().
//   ATMOS app   : governor / provincial_tourism / tourism_office / lgu tourism
//                 (isProvincialStaff, isLguStaff), establishments, tourists.
//
// Public catalogs: anyone can read; only staff can write.
// Nobody may give themselves an admin/manager role from the client.

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Shared helpers ─────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function userDocRole() {
      return userDocExists() ? get(userDocPath()).data.get('role', '') : '';
    }

    function authEmailLower() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    // ───────────────────────── Tourism app roles ─────────────────────────

    // Built-in / seeded provincial admins allowed to self-bootstrap role.
    function isKnownBootstrapAdminEmail() {
      return authEmailLower() in [
        'optaca@gmail.com',
        'sapinitmelane84@gmail.com'
      ];
    }

    // Doc id scheme matches AdminAccount.docIdForEmail in Dart.
    function adminAccountDocIdFromEmail() {
      return authEmailLower()
          .replace('@', '_at_')
          .replace('.', '_')
          .replace('.', '_')
          .replace('.', '_');
    }

    function adminAccountPath() {
      return /databases/$(database)/documents/admin_accounts/$(adminAccountDocIdFromEmail());
    }

    function isListedAdminAccount() {
      return isSignedIn()
        && authEmailLower() != ''
        && exists(adminAccountPath())
        && get(adminAccountPath()).data.emailLower == authEmailLower()
        && get(adminAccountPath()).data.active != false
        && isAdminRole(get(adminAccountPath()).data.role);
    }

    function tokenRole() {
      return isSignedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : '';
    }

    function tokenStaff() {
      return isSignedIn() && (
        request.auth.token.staff == true
        || request.auth.token.staff == 'true'
      );
    }

    function tokenAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || request.auth.token.admin == 'true'
      );
    }

    function isAdminRole(role) {
      return role is string && role in [
        'admin', 'Admin', 'administrator', 'Administrator', 'governor', 'Governor'
      ];
    }

    function isManagerRole(role) {
      return role is string && role in [
        'municipal_manager', 'Municipal Manager', 'municipal manager',
        'municipalmanager', 'manager', 'Manager'
      ];
    }

    function isTouristRole(role) {
      return !(role is string)
        || role in [
          'tourist', 'Tourist', 'user', 'User', 'guest', 'Guest', ''
        ];
    }

    function requestRoleOrTourist() {
      return request.resource.data.get('role', 'tourist');
    }

    function roleFieldUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'rolePermanent']);
    }

    function isPermanentStaffUser() {
      return userDocExists()
        && get(userDocPath()).data.get('rolePermanent', false) == true
        && (isAdminRole(userDocRole()) || isManagerRole(userDocRole()));
    }

    function isAdmin() {
      return tokenAdmin()
        || isAdminRole(tokenRole())
        || isAdminRole(userDocRole())
        || isListedAdminAccount();
    }

    function isMunicipalManager() {
      return isSignedIn() && (
        request.auth.token.municipal_manager == true
        || isManagerRole(tokenRole())
        || isManagerRole(userDocRole())
      );
    }

    function isStaff() {
      return tokenStaff() || isAdmin() || isMunicipalManager() || isPermanentStaffUser();
    }

    function canManagePublicCatalog() {
      return isStaff();
    }

    // ───────────────────────── ATMOS app roles ─────────────────────────

    function isAtmosStaffRole(role) {
      return role is string
        && (
          role.matches('(?i)^\\s*governor\\s*$')
          || role.matches('(?i)^\\s*provincial[_\\s-]?tourism\\s*$')
          || role.matches('(?i)^\\s*tourism[_\\s-]?province\\s*$')
          || role.matches('(?i)^\\s*tourism(_office)?\\s*$')
          || role.matches('(?i)^\\s*lgu\\s*tourism\\s*$')
          || role.matches('(?i)^\\s*tourism\\s*office\\s*$')
        );
    }

    function isProvincialStaffFromUserDoc() {
      return userDocExists() && isAtmosStaffRole(userDocRole());
    }

    // Tourism / governor demo and LGU staff emails (works before users/{uid} exists).
    function isKnownStaffEmail() {
      return authEmailLower() != ''
        && (
          authEmailLower().matches('^governor\\.atmos@misocc-demo\\.ph$')
          || authEmailLower().matches('^tourismoffice\\.atmos@misocc-demo\\.ph$')
          || authEmailLower().matches('^provincial\\.tourism@misocc-demo\\.ph$')
          || authEmailLower().matches('^tourism@gmail\\.com$')
          || authEmailLower().matches('^tourism\\.[^@]+@.+$')
          || authEmailLower().matches('^tourismoroquieta@.+$')
          || authEmailLower().matches('^oroquieta\\.tourism@.+$')
          || authEmailLower().matches('^.*\\.tourism@.+$')
          || authEmailLower().matches('^.*(tourism|governor|misocc|atmos).*@.+$')
        );
    }

    function lguMunicipalityId() {
      return userDocExists()
        ? get(userDocPath()).data.get('municipalityId', '')
        : '';
    }

    function isLguTourismFromUserDoc() {
      return userDocExists()
        && (
          userDocRole().matches('(?i)^\\s*tourism(_office)?\\s*$')
          || userDocRole().matches('(?i)^\\s*lgu\\s*tourism\\s*$')
        )
        && lguMunicipalityId() != '';
    }

    function isProvincialStaff() {
      return isSignedIn()
        && (isProvincialStaffFromUserDoc() || isKnownStaffEmail());
    }

    function isLguStaff() {
      return isProvincialStaff() || isLguTourismFromUserDoc();
    }

    function checkInInLguMunicipality() {
      return isLguTourismFromUserDoc()
        && resource.data.get('municipalityId', '') == lguMunicipalityId();
    }

    function canReadOwnCheckInRow() {
      return isSignedIn()
        && (
          resource.data.get('user_id', '') == request.auth.uid
          || resource.data.get('userId', '') == request.auth.uid
          || resource.data.get('tourist_id', '') == request.auth.uid
        );
    }

    function isCheckInOwner() {
      return isSignedIn()
        && request.resource.data.get('user_id', '') == request.auth.uid;
    }

    // ───────────────────────── users/{uid} role guards ─────────────────────────

    // Plain tourist profile (login sync, photo, name).
    function mayCreateOwnTouristProfile(userId) {
      return isOwner(userId)
        && isTouristRole(requestRoleOrTourist())
        && request.resource.data.get('rolePermanent', false) != true;
    }

    function mayUpdateOwnTouristProfile(userId) {
      return isOwner(userId)
        && isTouristRole(requestRoleOrTourist())
        && request.resource.data.get('rolePermanent', false) != true
        && (isTouristRole(resource.data.get('role', 'tourist')) || roleFieldUnchanged());
    }

    // ATMOS staff self-profile (tourism office / LGU tourism) for known staff
    // emails. Governor (= Tourism admin) only for the official demo account.
    function mayWriteOwnAtmosStaffProfile(userId) {
      return isOwner(userId)
        && isKnownStaffEmail()
        && isAtmosStaffRole(requestRoleOrTourist())
        && request.resource.data.get('rolePermanent', false) != true
        && (
          !isAdminRole(requestRoleOrTourist())
          || authEmailLower() == 'governor.atmos@misocc-demo.ph'
        );
    }

    // Listed bootstrap admin, or already-staff profile refreshing permanence.
    function mayPersistOwnStaffRole(userId) {
      return isOwner(userId)
        && request.resource.data.get('rolePermanent', false) == true
        && (
          isAdminRole(request.resource.data.get('role', ''))
          || isManagerRole(request.resource.data.get('role', ''))
        )
        && request.resource.data.get('emailLower', '') == authEmailLower()
        && (
          isKnownBootstrapAdminEmail()
          || isListedAdminAccount()
          || tokenStaff()
          || tokenAdmin()
          || isAdminRole(resource.data.get('role', ''))
          || isManagerRole(resource.data.get('role', ''))
        );
    }

    function mayBootstrapAdminCreate(userId) {
      return isOwner(userId)
        && (isKnownBootstrapAdminEmail() || isListedAdminAccount())
        && request.resource.data.get('rolePermanent', false) == true
        && isAdminRole(request.resource.data.get('role', ''))
        && request.resource.data.get('emailLower', '') == authEmailLower();
    }

    // Staff editing someone else: may not hand out admin/manager roles.
    function staffEditKeepsRoleSafe() {
      return roleFieldUnchanged()
        || isTouristRole(requestRoleOrTourist())
        || (isAtmosStaffRole(requestRoleOrTourist()) && !isAdminRole(requestRoleOrTourist()));
    }

    // ───────────────────────── Public catalogs (both apps) ─────────────────────────

    match /tourist_spots/{docId} {
      allow read: if true;
      // ATMOS LGU / establishment accounts edit spots + QR metadata.
      allow create, update: if isSignedIn();
      allow delete: if isStaff() || isLguStaff();
    }
    match /municipalities/{docId} {
      allow read: if true;
      allow write: if canManagePublicCatalog();
    }
    match /featured_spots/{docId} {
      allow read: if true;
      allow write: if canManagePublicCatalog();
    }
    match /events/{docId} {
      allow read: if true;
      allow write: if canManagePublicCatalog() || isLguStaff();
    }
    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if canManagePublicCatalog() || isLguStaff();
    }
    match /transportation_fees/{docId} {
      allow read: if true;
      allow write: if canManagePublicCatalog();
    }
    match /hub_spot_transport_fees/{docId} {
      allow read: if true;
      allow write: if canManagePublicCatalog();
    }
    match /municipal_road_distances/{docId} {
      allow read: if true;
      allow write: if canManagePublicCatalog();
    }
    match /vr_tours/{vrTourId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ───────────────────────── Ratings & reviews ─────────────────────────

    // Tourism app spot ratings + comments.
    match /spot_ratings/{docId} {
      allow read: if true;
      allow create: if isStaff()
        || (
          isSignedIn()
          && request.resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 0
          && request.resource.data.rating <= 5
          && request.resource.data.spotName is string
          && request.resource.data.spotName.size() > 0
        );
      allow update, delete: if isStaff()
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
    }

    // ATMOS spot reviews.
    match /spot_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() >= 10;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid)
                    || isLguStaff() || isStaff();
    }

    // ───────────────────────── Tourism app private data ─────────────────────────

    match /recommendation_profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Pre-seeded admin rows only. Users cannot invent a new admin account.
    match /admin_accounts/{accountId} {
      allow get: if isSignedIn() && (
        isStaff()
        || !exists(/databases/$(database)/documents/admin_accounts/$(accountId))
        || resource.data.emailLower == authEmailLower()
        || resource.data.firebaseUid == request.auth.uid
      );
      allow list: if isStaff();
      allow create, delete: if isAdmin();
      // Bind Auth uid onto an existing listed admin row (first login).
      allow update: if isAdmin()
        || (
          isSignedIn()
          && authEmailLower() != ''
          && resource.data.emailLower == authEmailLower()
          && isAdminRole(resource.data.role)
          && resource.data.active != false
          && request.resource.data.emailLower == authEmailLower()
          && request.resource.data.firebaseUid == request.auth.uid
          && isAdminRole(request.resource.data.role)
        );
    }

    match /tourist/{touristId} {
      allow read: if isOwner(touristId) || isStaff();
      allow create, update: if isOwner(touristId);
      allow delete: if isAdmin();
    }

    match /tourist_visits/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isStaff()
        || request.resource.data.get('firebaseUid', '') == request.auth.uid
        || request.resource.data.get('userId', '') == request.auth.uid
        || request.resource.data.get('touristId', '') == request.auth.uid
      );
      allow update, delete: if isStaff();
    }

    match /qr_check_ins/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }

    // ───────────────────────── Shared: users & tourists ─────────────────────────

    match /users/{userId} {
      // ATMOS dashboards list users; Tourism app reads own profile.
      allow read: if isSignedIn();
      allow create: if mayCreateOwnTouristProfile(userId)
        || mayBootstrapAdminCreate(userId)
        || mayWriteOwnAtmosStaffProfile(userId)
        || ((isStaff() || isLguStaff())
            && !isOwner(userId)
            && isTouristRole(requestRoleOrTourist()));
      allow update: if isAdmin()
        || mayPersistOwnStaffRole(userId)
        || mayUpdateOwnTouristProfile(userId)
        || mayWriteOwnAtmosStaffProfile(userId)
        || (isOwner(userId) && roleFieldUnchanged())
        || ((isStaff() || isLguStaff()) && !isOwner(userId) && staffEditKeepsRoleSafe());
      allow delete: if isAdmin()
        || (isLguStaff() && isTouristRole(resource.data.get('role', 'tourist')));

      match /faq_chats/{messageId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /tourists/{touristId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (
          request.auth.uid == touristId
          || request.resource.data.get('firebaseUid', '') == request.auth.uid
          || isLguStaff()
          || isStaff()
        );
      allow update: if isSignedIn()
        && (
          request.auth.uid == touristId
          || (
            resource.data.get('firebaseUid', '') == request.auth.uid
            && request.resource.data.get('firebaseUid', '') == request.auth.uid
          )
          || isLguStaff()
          || isStaff()
        );
      allow delete: if isAdmin() || isLguStaff();
    }

    // ───────────────────────── ATMOS app data ─────────────────────────

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /tourist_activity/{userId} {
      allow read, write: if isOwner(userId);
      allow delete: if isLguStaff();
    }

    match /email_otps/{otpUid} {
      allow read, create, update, delete: if isOwner(otpUid);
      allow delete: if isLguStaff();
    }

    match /check_ins/{docId} {
      allow get: if isLguStaff() || canReadOwnCheckInRow();
      allow list: if isLguStaff() || canReadOwnCheckInRow() || checkInInLguMunicipality();
      allow create, update: if isSignedIn();
      allow delete: if isLguStaff();
    }

    match /qr_checkins/{docId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && (resource.data.get('tourist_id', '') == request.auth.uid
                        || isLguStaff()
                        || isStaff());
      allow delete: if isLguStaff() || isStaff();
    }

    match /checkins/{docId} {
      allow get: if isLguStaff() || canReadOwnCheckInRow();
      allow list: if isLguStaff() || canReadOwnCheckInRow() || checkInInLguMunicipality();
      allow create: if isCheckInOwner() || isLguStaff();
      allow update: if false;
      allow delete: if isLguStaff();
    }

    // Provincial Tourism Office campaigns (province-wide promotions).
    match /provincial_campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isProvincialStaff();
    }

    // LGU → OPTACA (Provincial Tourism) formal report packages.
    match /lgu_report_submissions/{submissionId} {
      allow read: if isLguStaff();
      allow create: if isLguStaff()
        && request.resource.data.keys().hasAll([
          'municipalityId',
          'reportType',
          'status',
          'periodStart',
          'periodEnd',
          'submittedByUid',
          'submittedAt',
        ])
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow update: if isProvincialStaff()
        || (
          isLguStaff()
          && resource.data.submittedByUid == request.auth.uid
          && request.resource.data.status == 'withdrawn'
        );
      allow delete: if isProvincialStaff();
    }

    match /tourist_qr_codes/{touristId} {
      allow read: if isOwner(touristId);
      allow create, update: if isOwner(touristId);
      allow delete: if isOwner(touristId) || isLguStaff();
    }

    match /tourist_qr_codes/{touristId}/history/{historyId} {
      allow read: if isOwner(touristId);
      allow create: if isOwner(touristId);
      allow update: if false;
      allow delete: if isOwner(touristId) || isLguStaff();
    }

    // Unique usernames for tourism establishment accounts.
    match /usernames/{usernameId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid)
                    || isLguStaff();
    }

    // Tourism establishments (hotels, resorts, restaurants, attractions, …).
    match /accommodation_establishments/{estId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && (
                      request.resource.data.get('ownerUid', '') == request.auth.uid
                      || request.resource.data.get('authUid', '') == request.auth.uid
                      || estId == request.auth.uid
                      || isLguStaff()
                    );
      allow update: if isSignedIn()
                    && (
                      resource.data.get('ownerUid', '') == request.auth.uid
                      || resource.data.get('authUid', '') == request.auth.uid
                      || estId == request.auth.uid
                      || isLguStaff()
                    );
      allow delete: if isLguStaff();
    }

    // Hotel / AE stay requests: tourist scan → staff confirm → checkout → receipt.
    match /establishment_stay_requests/{stayId} {
      allow get: if isSignedIn()
        && (
          resource.data.touristId == request.auth.uid
          || resource.data.establishmentId == request.auth.uid
          || isLguStaff()
        );
      allow list: if true;
      allow create: if isSignedIn()
        && request.resource.data.touristId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.establishmentId is string
        && request.resource.data.establishmentId.size() > 0;
      allow update: if isSignedIn()
        && (
          resource.data.establishmentId == request.auth.uid
          || isLguStaff()
          || (
            resource.data.touristId == request.auth.uid
            && resource.data.status == 'confirmed'
            && request.resource.data.status == 'checked_out'
            && request.resource.data.touristId == resource.data.touristId
            && request.resource.data.establishmentId == resource.data.establishmentId
          )
        );
      allow delete: if isLguStaff()
        || (isSignedIn() && resource.data.establishmentId == request.auth.uid);
    }

    // Guest reviews after establishment stay checkout.
    match /establishment_stay_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.touristId == request.auth.uid
        && request.resource.data.hotelRating is number
        && request.resource.data.hotelRating >= 1
        && request.resource.data.hotelRating <= 5
        && request.resource.data.roomRating is number
        && request.resource.data.roomRating >= 1
        && request.resource.data.roomRating <= 5
        && request.resource.data.stayRequestId is string
        && request.resource.data.establishmentId is string;
      allow update: if isSignedIn()
        && resource.data.touristId == request.auth.uid
        && request.resource.data.touristId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.touristId == request.auth.uid)
        || isLguStaff();
    }

    // Deny anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
