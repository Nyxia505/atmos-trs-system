# Copy to functions/.env.atmos-trs-system for deploy params (do not commit secrets)
# Semaphore: https://semaphore.co — must match an APPROVED sender name in your dashboard
SEMAPHORE_SENDER_NAME=ATMOS
SEMAPHORE_API_KEY=

# Optional Gmail SMTP for OTP inbox delivery (recommended over EmailJS for Gmail users):
# Use a Google Workspace / Gmail account with an App Password (2FA required).
# GMAIL_SMTP_USER=tourismoffice.atmos@misocc-demo.ph
# GMAIL_SMTP_APP_PASSWORD=your-16-char-app-password
# OTP_INBOX_REPLY_TO=tourismoffice.atmos@misocc-demo.ph
# OTP_INBOX_FROM_NAME=ATMOS-TRS Tourism